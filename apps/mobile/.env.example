# Same Supabase project as the web app's .env.local (NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_ANON_KEY) — copy those two values here. The anon key is
# safe to ship in the mobile bundle, same as it already is in the web bundle;
# RLS policies are what actually gate access, not secrecy of this key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed web app, used for API routes the mobile app calls
# with a bearer token (orders, photos, photographer/admin actions) and for
# the KKiaPay checkout WebView bridge page.
EXPO_PUBLIC_APP_URL=http://localhost:3000
