# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Wave / Orange Money (via l'agrégateur KKiaPay) ---
# Clé publique : utilisée aussi côté navigateur pour ouvrir le widget.
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
NEXT_PUBLIC_KKIAPAY_SANDBOX=true
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=

# --- Resend (emails transactionnels) ---
RESEND_API_KEY=
EMAIL_FROM=Senshoot Sénégal <onboarding@resend.dev>

# --- Limites de débit partagées (Upstash Redis, optionnel) ---
# Sans ces variables, les limites (connexion, inscription, commandes…) sont
# comptées EN MÉMOIRE, séparément par instance du serveur : moins strictes en
# production. Avec Upstash, le compteur est partagé entre toutes les instances.
# Via l'intégration Vercel (Storage > Upstash Redis), ce sont les variables
# KV_REST_API_URL / KV_REST_API_TOKEN qui sont créées : elles sont aussi lues.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron (rappel d'expiration d'abonnement) ---
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Senshoot Sénégal

# --- Sentry (suivi des erreurs) ---
# Sans DSN, le SDK reste inactif (no-op) — rien à configurer pour développer en local.
NEXT_PUBLIC_SENTRY_DSN=
# Optionnels, uniquement pour l'upload des source maps au build (CI/CD) :
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
